<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">

                    <div class="text-center mb-4">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                            style="width: 60px; height: 60px;">
                            <i class="fas fa-user-plus fs-4"></i>
                        </div>
                        <h2 class="fw-bold text-dark">Admisión de Paciente</h2>
                        <p class="text-muted small">Ingrese los datos correspondientes para generar la ficha clínica.
                        </p>
                    </div>

                    <form id="form-add-user">
                        <div class="mb-3">
                            <label for="firstname" class="form-label fw-semibold text-secondary">Nombre:</label>
                            <input type="text" class="form-control form-control-lg fs-6" id="firstname" name="firstname"
                                placeholder="Ej: María" required>
                        </div>

                        <div class="mb-3">
                            <label for="lastname" class="form-label fw-semibold text-secondary">Apellido:</label>
                            <input type="text" class="form-control form-control-lg fs-6" id="lastname" name="lastname"
                                placeholder="Ej: González" required>
                        </div>

                        <div class="mb-3">
                            <label for="rut" class="form-label fw-semibold text-secondary">RUT / Identificación:</label>
                            <input type="text" class="form-control form-control-lg fs-6" id="rut" name="rut"
                                placeholder="Ej: 12.345.678-9" required>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold text-secondary">Correo Electrónico:</label>
                            <input type="email" class="form-control form-control-lg fs-6" id="email" name="email"
                                placeholder="Ej: correo@dominio.com" required>
                        </div>

                        <!-- CAMPO DE TELÉFONO -->
                        <div class="mb-4">
                            <label for="telefono" class="form-label fw-semibold text-secondary">Teléfono:</label>
                            <input type="tel" class="form-control form-control-lg fs-6" id="telefono" name="telefono"
                                placeholder="Ej: +56912345678">
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="reset"
                                class="btn btn-outline-secondary px-4 py-2 rounded-pill">Limpiar</button>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm">Registrar
                                Paciente</button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<script>
    const formAddUser = document.getElementById("form-add-user");

    if (formAddUser) {
        formAddUser.addEventListener("submit", async (event) => {
            event.preventDefault();

            const firstname = document.getElementById("firstname").value;
            const lastname = document.getElementById("lastname").value;
            const rut = document.getElementById("rut").value;
            const email = document.getElementById("email").value;
            const telefono = document.getElementById("telefono").value; // Capturamos el teléfono

            try {
                const response = await fetch("/api/users", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ firstname, lastname, email, rut, telefono }) // Lo enviamos al backend
                });

                const data = await response.json();

                if (!response.ok) {
                    return alert(data.message || "Ocurrió un error al registrar");
                }

                alert(data.message);

                setTimeout(() => {
                    window.location.href = "/users";
                }, 1000);

            } catch (error) {
                console.error("Error en la petición:", error);
                alert("Error de conexión con el servidor.");
            }
        });
    }
</script>