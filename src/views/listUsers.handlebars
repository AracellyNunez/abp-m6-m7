<div id="view-list-users" class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Listado de Pacientes</h2>
            <p class="text-muted mb-0">Centro de Salud - Sistema de Gestión y Fichas Clínicas</p>
        </div>
        <a href="/users/add" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Registrar Nuevo Paciente
        </a>
    </div>

    {{#if users}}

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase fs-7">
                        <tr>
                            <th scope="col" class="py-3 ps-4">N° Ficha</th>
                            <th scope="col" class="py-3">Nombre</th>
                            <th scope="col" class="py-3">Apellido</th>
                            <th scope="col" class="py-3">RUT</th>
                            <th scope="col" class="py-3">Correo</th>
                            <th scope="col" class="py-3">Fecha Registro</th>
                            <th scope="col" class="py-3 text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="table-body">
                        {{#each users}}
                        <tr>
                            <th scope="row" class="ps-4 text-dark">{{id}}</th>
                            <td class="fw-semibold">{{firstname}}</td>
                            <td>{{lastname}}</td>
                            <td><span class="badge bg-light text-dark border px-2 py-1">{{rut}}</span></td>
                            <td class="text-muted">{{email}}</td>
                            <td class="text-muted small">{{createdAt}}</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="/users/profile/{{id}}" class="btn btn-outline-info">Ver</a>
                                    <a href="/users/update/{{id}}" class="btn btn-outline-warning">Editar</a>
                                    <button class="btn btn-outline-danger btn-eliminar"
                                        data-id-user="{{id}}">Eliminar</button>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{else}}
    <div class="card shadow-sm border-0 rounded-4 text-center py-5">
        <div class="card-body">
            <p class="text-muted fs-4 mb-3">No hay pacientes registrados para mostrar...</p>
            <a href="/users/add" class="btn btn-primary px-4">Registrar el primer paciente</a>
        </div>
    </div>
    {{/if}}

</div>

<script>
    const tableBody = document.getElementById("table-body");

    if (tableBody) {
        tableBody.addEventListener("click", async (event) => {
            const elemento = event.target;

            if (elemento.classList.contains("btn-eliminar") || elemento.className.includes("btn-eliminar")) {
                let id = elemento.dataset.idUser;

                let confirmacion = confirm("¿Está seguro que desea eliminar el registro del paciente con ficha N°:\n" + id + "?");

                if (!confirmacion) return false;

                const response = await fetch("/api/users/" + id, { method: "DELETE" });
                const data = await response.json();

                if (response.status != 200) {
                    return alert(data.message);
                }

                alert(data.message);

                setTimeout(() => {
                    location.reload();
                }, 1000);
            }
        });
    }
</script>