<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                    <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow"
                        style="width: 70px; height: 70px;">
                        <i class="fas fa-file-medical fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-0">Ficha Clínica de Paciente</h3>
                    <p class="mb-0 small opacity-75">Centro de Salud M6 - Registro Oficial</p>
                </div>

                <div class="card-body p-5">

                    <div class="mb-4 text-center">
                        <span class="badge bg-light text-dark border px-3 py-2 fs-6 rounded-pill">
                            N° de Ficha: <strong class="text-primary">{{user.id}}</strong>
                        </span>
                    </div>

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted fw-semibold"><i class="fas fa-user me-2 text-secondary"></i>
                                Nombres:</span>
                            <span class="fw-bold text-dark">{{user.firstname}}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted fw-semibold"><i class="fas fa-user-tag me-2 text-secondary"></i>
                                Apellidos:</span>
                            <span class="fw-bold text-dark">{{user.lastname}}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted fw-semibold"><i class="fas fa-id-card me-2 text-secondary"></i> RUT
                                / Identificación:</span>
                            <span class="badge bg-secondary fs-6 px-3 py-1">{{user.rut}}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted fw-semibold"><i class="fas fa-envelope me-2 text-secondary"></i>
                                Correo Electrónico:</span>
                            <span class="text-dark">{{user.email}}</span>
                        </li>
                    </ul>

                    <!-- Fichas Médicas -->
                    <div class="mt-4 pt-3 border-top">
                        <h5 class="fw-bold text-primary mb-3"><i class="fas fa-notes-medical me-2"></i>Fichas Médicas
                        </h5>
                        {{#if user.fichas.length}}
                        <div class="list-group mb-4">
                            {{#each user.fichas}}
                            <div class="list-group-item list-group-item-action p-3 rounded-3 mb-2 shadow-sm border">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 text-dark fw-bold">Ficha N° {{this.id}}</h6>
                                    <small class="text-muted">{{this.createdAt}}</small>
                                </div>
                                <p class="mb-1 text-secondary small"><strong>Detalle:</strong> {{this.descripcion}}</p>
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <p class="text-muted fst-italic small mb-4">Este paciente aún no registra fichas asociadas.</p>
                        {{/if}}

                        <!-- Exámenes Médicos -->
                        <h5 class="fw-bold text-primary mb-3"><i class="fas fa-vials me-2"></i>Exámenes Médicos</h5>
                        {{#if user.examenes.length}}
                        <ul class="list-group mb-4">
                            {{#each user.examenes}}
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <span class="small"><i
                                        class="fas fa-file-prescription me-2 text-secondary"></i>{{this.nombre}}</span>
                                <span class="badge bg-info text-dark">{{this.resultado}}</span>
                            </li>
                            {{/each}}
                        </ul>
                        {{else}}
                        <p class="text-muted fst-italic small mb-4">No hay exámenes registrados para este paciente.</p>
                        {{/if}}
                    </div>

                    <!-- Botones de Acción -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4">
                        <a href="/users" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                            <i class="fas fa-arrow-left me-2"></i> Volver al Listado
                        </a>
                        <a href="/users/update/{{user.id}}"
                            class="btn btn-warning px-4 py-2 rounded-pill text-white fw-semibold shadow-sm">
                            <i class="fas fa-edit me-2"></i> Editar Paciente
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>