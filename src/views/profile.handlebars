<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <!-- Tarjeta Principal del Paciente -->
            <div class="card shadow-lg border-0 rounded-4">

                <!-- Encabezado -->
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                    <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow"
                        style="width: 60px; height: 60px;">
                        <i class="fas fa-user-injured fs-4"></i>
                    </div>
                    <h3 class="fw-bold mb-0">Perfil del Paciente</h3>
                    <p class="mb-0 small opacity-75">ID de Ficha: {{user.id}}</p>
                </div>

                <!-- Cuerpo de la Tarjeta -->
                <div class="card-body p-4 p-md-5">

                    <!-- Información Personal -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-secondary mb-3"><i class="fas fa-info-circle me-2"></i>Datos Personales
                        </h5>
                        <ul class="list-group list-group-flush border rounded-3 overflow-hidden">
                            <li class="list-group-item d-flex justify-content-between py-3">
                                <span class="text-muted fw-semibold">Nombre completo:</span>
                                <span class="fw-bold text-dark">{{user.firstname}} {{user.lastname}}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between py-3">
                                <span class="text-muted fw-semibold">RUT / Identificación:</span>
                                <span class="badge bg-secondary fs-6">{{user.rut}}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between py-3">
                                <span class="text-muted fw-semibold">Correo Electrónico:</span>
                                <span class="text-dark">{{user.email}}</span>
                            </li>
                            <!-- TELÉFONO AGREGADO AQUÍ -->
                            <li class="list-group-item d-flex justify-content-between py-3">
                                <span class="text-muted fw-semibold">Teléfono:</span>
                                <span class="text-dark">{{user.telefono}}</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Sección de Fichas Médicas -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-primary mb-0"><i class="fas fa-notes-medical me-2"></i>Fichas
                                Médicas</h5>
                            <a href="/fichas/add/{{user.id}}" class="btn btn-sm btn-primary rounded-pill px-3">
                                <i class="fas fa-plus me-1"></i> Nueva Ficha
                            </a>
                        </div>

                        {{#if user.fichas.length}}
                        {{#each user.fichas}}
                        <div class="card border mb-3 shadow-sm rounded-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0">Diagnóstico: {{this.diagnostico}}</h6>
                                    <small class="text-muted">{{this.fechaAtencion}}</small>
                                </div>
                                <p class="text-muted small mb-3"><strong>Observaciones:</strong> {{this.observaciones}}
                                </p>

                                {{#if this.archivo}}
                                <a href="/uploads/{{this.archivo}}" target="_blank"
                                    class="btn btn-sm btn-outline-primary rounded-pill">
                                    <i class="fas fa-external-link-alt me-1"></i> Ver Documento Adjunto
                                </a>
                                {{else}}
                                <span class="text-muted small fst-italic">Sin archivo adjunto</span>
                                {{/if}}
                            </div>
                        </div>
                        {{/each}}
                        {{else}}
                        <div class="alert alert-light border text-center text-muted py-3 rounded-3">
                            Este paciente aún no registra fichas clínicas.
                        </div>
                        {{/if}}
                    </div>

                    <!-- Sección de Exámenes Médicos -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-success mb-0"><i class="fas fa-vials me-2"></i>Exámenes Médicos</h5>
                            <a href="/examenes/add/{{user.id}}" class="btn btn-sm btn-success rounded-pill px-3">
                                <i class="fas fa-plus me-1"></i> Nuevo Examen
                            </a>
                        </div>

                        {{#if user.examenes.length}}
                        {{#each user.examenes}}
                        <div class="card border mb-3 shadow-sm rounded-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0">{{this.nombre}}</h6>
                                    <span class="badge bg-info text-dark">{{this.resultado}}</span>
                                </div>

                                {{#if this.archivo}}
                                <a href="/uploads/{{this.archivo}}" target="_blank"
                                    class="btn btn-sm btn-outline-success rounded-pill">
                                    <i class="fas fa-external-link-alt me-1"></i> Ver Examen Escaneado
                                </a>
                                {{else}}
                                <span class="text-muted small fst-italic">Sin archivo adjunto</span>
                                {{/if}}
                            </div>
                        </div>
                        {{/each}}
                        {{else}}
                        <div class="alert alert-light border text-center text-muted py-3 rounded-3">
                            No hay exámenes registrados para este paciente.
                        </div>
                        {{/if}}
                    </div>

                    <!-- Botones de Navegación Inferior -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a href="/users" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="fas fa-arrow-left me-2"></i> Volver
                        </a>
                        <a href="/users/update/{{user.id}}"
                            class="btn btn-warning text-white fw-semibold rounded-pill px-4">
                            <i class="fas fa-edit me-2"></i> Editar Paciente
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>