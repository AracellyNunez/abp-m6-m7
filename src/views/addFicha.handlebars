<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">Registrar Nueva Ficha Clínica</h4>
                </div>
                <div class="card-body p-4">

                    <!-- Agregamos un id para controlarlo -->
                    <form id="formFicha">

                        <input type="hidden" name="userId" value="{{userId}}">

                        <div class="mb-3">
                            <label for="diagnostico" class="form-label fw-semibold">Diagnóstico</label>
                            <input type="text" class="form-control" id="diagnostico" name="diagnostico" required>
                        </div>

                        <div class="mb-3">
                            <label for="fechaAtencion" class="form-label fw-semibold">Fecha de Atención</label>
                            <input type="date" class="form-control" id="fechaAtencion" name="fechaAtencion" required>
                        </div>

                        <div class="mb-3">
                            <label for="observaciones" class="form-label fw-semibold">Observaciones</label>
                            <textarea class="form-control" id="observaciones" name="observaciones" rows="3"></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="archivo" class="form-label fw-semibold">Documento o Imagen Adjunta</label>
                            <input type="file" class="form-control" id="archivo" name="archivo">
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/users/profile/{{userId}}"
                                class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">Guardar Ficha</button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('formFicha').addEventListener('submit', async (e) => {
        e.preventDefault();

        const form = e.target;
        const formData = new FormData(form);
        const userId = form.querySelector('input[name="userId"]').value;

        // Recuperamos el token que se guardó en el navegador al hacer login
        const token = localStorage.getItem('token');

        try {
            const response = await fetch('/api/fichas', {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}` // Aquí va el JWT limpio que exige tu proyecto
                },
                body: formData // Envía textos y archivos juntos perfectamente
            });

            if (response.ok) {
                window.location.href = `/users/profile/${userId}`;
            } else {
                const errorData = await response.json();
                alert("Error al guardar: " + (errorData.message || "Token inválido"));
            }
        } catch (error) {
            console.error("Error:", error);
            alert("No se pudo conectar con el servidor.");
        }
    });
</script>